# AutoTest-Agent Environment Configuration
# Copy this file to .env and customize for your environment
# 适配中国大陆网络环境，默认使用国内镜像源

# ===== Database Configuration =====
DATABASE_URL=postgresql+asyncpg://autotest:autotest_pass@localhost:5432/autotest
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===== Redis / Celery =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== LLM Providers (JSON format) =====
LLM_PROVIDERS={"openai": {"api_key": "", "model": "gpt-4o"}}

# ===== Server Configuration =====
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
DEBUG=false
FRONTEND_PORT=3000

# ===== Docker Sandbox Configuration =====
DOCKER_HOST=unix:///var/run/docker.sock
# Docker registry mirror for China network (Alibaba Cloud)
DOCKER_MIRROR=registry.cn-hangzhou.aliyuncs.com
SANDBOX_MAX_CPU=2
SANDBOX_MAX_MEMORY=2g
SANDBOX_TIMEOUT=300

# ===== Concurrency Settings =====
MAX_CONCURRENCY=10
MIN_CONCURRENCY=2
CPU_THRESHOLD_PERCENT=80
MEMORY_THRESHOLD_PERCENT=85

# ===== Package Registries (China mirrors) =====
# Python pip mirror (Tsinghua University)
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Node.js npm mirror (Taobao)
NPM_REGISTRY=https://registry.npmmirror.com

# ===== Security Keys =====
# IMPORTANT: Change these in production!
SECRET_KEY=change-me-in-production-use-long-random-string-here-1234567890
API_KEY_ENCRYPTION_KEY=change-me-in-production-use-long-random-string-here-0987654321

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
