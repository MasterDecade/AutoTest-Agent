# AutoTest-Agent 环境变量配置模板
# 复制为 .env 后修改实际值

# ===== 数据库 =====
DATABASE_URL=postgresql://autotest:autotest_pass@localhost:5432/autotest
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===== Redis / Celery =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== LLM API Keys (JSON 格式，支持多 Provider) =====
# 示例: {"openai": {"api_key": "sk-xxx", "base_url": "", "model": "gpt-4o"}, "qwen": {...}}
LLM_PROVIDERS={"openai": {"api_key": "your-openai-api-key", "model": "gpt-4o"}}

# ===== 服务配置 =====
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4
DEBUG=false

# ===== 前端配置 =====
FRONTEND_PORT=3000

# ===== Docker 沙箱配置 =====
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_MIRROR=registry.cn-hangzhou.aliyuncs.com
SANDBOX_MAX_CPU=2
SANDBOX_MAX_MEMORY=2g
SANDBOX_TIMEOUT=300

# ===== 并发调度 =====
MAX_CONCURRENCY=10
MIN_CONCURRENCY=2
CPU_THRESHOLD_PERCENT=80
MEMORY_THRESHOLD_PERCENT=85

# ===== 国内镜像源 =====
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com

# ===== 安全 =====
SECRET_KEY=change-me-in-production
API_KEY_ENCRYPTION_KEY=change-me-in-production

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FILE=/var/log/autotest-agent/app.log